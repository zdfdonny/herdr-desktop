{
  "name": "herdr-desktop",
  "productName": "Herdr",
  "desktopName": "herdr-desktop.desktop",
  "version": "0.1.1",
  "description": "Multi-agent management desktop app - the runtime your coding agents live on.",
  "license": "MIT",
  "author": {
    "name": "herdr-desktop contributors",
    "email": "zdfdonny@163.com"
  },
  "homepage": "https://github.com/zdfdonny/herdr-desktop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zdfdonny/herdr-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/zdfdonny/herdr-desktop/issues"
  },
  "keywords": [
    "electron",
    "ai-agent",
    "coding-agent",
    "terminal",
    "xterm",
    "claude-code",
    "codex",
    "multi-agent"
  ],
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "icon": "node scripts/sync-icon.js",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:win:x64": "electron-vite build && electron-builder --win --x64",
    "dist:win:arm64": "electron-vite build && electron-builder --win --arm64",
    "dist:mac:x64": "electron-vite build && electron-builder --mac --x64",
    "dist:mac:arm64": "electron-vite build && electron-builder --mac --arm64",
    "dist:linux:x64": "electron-vite build && electron-builder --linux --x64",
    "dist:linux:arm64": "electron-vite build && electron-builder --linux --arm64",
    "test": "npm run test:all",
    "test:all": "node scripts/test-all.mjs",
    "test:unix": "esbuild electron/platform/unix.ts --bundle --platform=node --format=esm --outfile=.tmp/unix.mjs && node scripts/test-unix-platform.mjs",
    "test:layout": "esbuild src/stores/layoutStore.ts --bundle --platform=node --format=esm --outfile=.tmp/layout.mjs && node scripts/test-layout-store.mjs",
    "test:sort": "esbuild src/stores/agentSort.ts --bundle --platform=node --format=esm --outfile=.tmp/agentsort.mjs && esbuild src/stores/agentsStore.ts --bundle --platform=node --format=esm --outfile=.tmp/agentpresets.mjs && node scripts/test-agent-sort.mjs",
    "test:pane-nav": "esbuild src/shortcuts/paneNavigation.ts --bundle --platform=node --format=esm --outfile=.tmp/pane-nav.mjs && node scripts/test-pane-nav.mjs",
    "test:picker": "esbuild src/components/agent-picker-position.ts --bundle --platform=node --format=esm --outfile=.tmp/agent-picker-position.mjs && node scripts/test-agent-picker-position.mjs",
    "test:integrations": "esbuild src/stores/integration-updates.ts --bundle --platform=node --format=esm --outfile=.tmp/integration-updates.mjs && node scripts/test-integration-updates.mjs",
    "test:integrations-store": "esbuild scripts/test-integrations-store.entry.mjs --bundle --platform=node --format=esm --outfile=.tmp/integrations-store.mjs && node scripts/test-integrations-store.mjs",
    "test:conpty-dll": "node scripts/test-conpty-dll.mjs",
    "test:shortcuts": "esbuild src/shortcuts/capture.ts --bundle --platform=node --format=esm --outfile=.tmp/shortcuts.mjs && node scripts/test-shortcuts.mjs",
    "test:terminal-state": "esbuild electron/runtime/terminal/terminal-state.ts --bundle --platform=node --format=esm --outfile=.tmp/terminal-state.mjs && esbuild shared/agents/status.ts --bundle --platform=node --format=esm --outfile=.tmp/agent-status.mjs && esbuild shared/detect/facade.ts --bundle --platform=node --format=esm --outfile=.tmp/detect-manifest.mjs && esbuild electron/runtime/agent-detector.ts --bundle --platform=node --format=esm --outfile=.tmp/agent-detector.mjs && esbuild electron/runtime/session.ts --bundle --platform=node --format=esm --outfile=.tmp/session.mjs && node scripts/test-terminal-state.mjs",
    "test:agent-policy": "esbuild scripts/test-agent-policy.entry.mjs --bundle --platform=node --format=esm --outfile=.tmp/agent-policy.mjs && node scripts/test-agent-policy.mjs",
    "test:integration-version": "node scripts/test-integration-version.mjs",
    "test:pane-service": "esbuild scripts/test-pane-service.entry.mjs --bundle --platform=node --format=esm --outfile=.tmp/pane-service.mjs && node scripts/test-pane-service.mjs",
    "test:dsh-binding": "esbuild scripts/test-dsh-binding.entry.mjs --bundle --platform=node --format=esm --outfile=.tmp/dsh-binding.mjs && node scripts/test-dsh-binding.mjs",
    "test:state-arbiter": "esbuild scripts/test-state-arbiter.entry.mjs --bundle --platform=node --format=esm --outfile=.tmp/state-arbiter.mjs && node scripts/test-state-arbiter.mjs",
    "test:agent-runtime": "esbuild scripts/test-agent-runtime.entry.mjs --bundle --platform=node --format=esm --outfile=.tmp/agent-runtime.mjs && node scripts/test-agent-runtime.mjs",
    "test:arbitration": "esbuild scripts/test-arbitration.entry.mjs --bundle --platform=node --format=esm --outfile=.tmp/arbitration.mjs && node scripts/test-arbitration.mjs",
    "test:suppression-ledger": "esbuild scripts/test-suppression-ledger.entry.mjs --bundle --platform=node --format=esm --outfile=.tmp/suppression-ledger.mjs && node scripts/test-suppression-ledger.mjs",
    "test:installer-snapshots": "node scripts/build-installer-snapshots.mjs && node scripts/test-installer-snapshots.cjs",
    "test:json-hooks-installer": "node scripts/build-json-hooks-installer.mjs && node scripts/test-json-hooks-installer.cjs",
    "test:notification-scheduler": "esbuild scripts/test-notification-scheduler.entry.mjs --bundle --platform=node --format=esm --outfile=.tmp/notification-scheduler.mjs && node scripts/test-notification-scheduler.mjs",
    "test:detect-engine": "esbuild scripts/test-detect-engine.entry.mjs --bundle --platform=node --format=esm --outfile=.tmp/detect-engine.mjs && node scripts/test-detect-engine.mjs",
    "check:agent-boundaries": "node scripts/check-agent-boundaries.mjs",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:artifacts": "node scripts/check-artifacts.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "6.0.0",
    "jsonc-parser": "^3.3.1",
    "node-pty": "1.1.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "44.4.2",
    "electron-builder": "26.15.3",
    "electron-vite": "4.0.0",
    "typescript": "5.7.3",
    "vite": "6.0.11"
  },
  "build": {
    "appId": "dev.herdr.desktop",
    "productName": "Herdr",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "afterPack": "scripts/after-pack.js",
    "artifactName": "herdr-desktop-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ],
      "syncDesktopName": true,
      "synopsis": "Multi-agent management desktop app",
      "maintainer": "herdr-desktop contributors <zdfdonny@163.com>"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "herdr-desktop-${version}-win-${arch}-setup.${ext}"
    }
  }
}
